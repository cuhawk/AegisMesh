{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trustDomain",
    "spireParent",
    "workloads",
    "resources",
    "rules",
    "neverReach"
  ],
  "properties": {
    "trustDomain": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+\\.[a-z0-9.-]+$"
    },
    "spireParent": {
      "type": "string",
      "pattern": "^spiffe://[a-z0-9.-]+/spire/agent/.+$"
    },
    "workloads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workload"
      },
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "neverReach": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pair"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AegisMesh intent",
  "$defs": {
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "namespace",
        "serviceAccount",
        "tenant",
        "svidTTL"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "serviceAccount": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "tenant": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "svidTTL": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "ingress": {
          "type": "boolean"
        },
        "untrusted": {
          "type": "boolean"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "kind": {
          "enum": [
            "fqdn",
            "vault",
            "object",
            "role",
            "metadata",
            "internet",
            "cidr"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "from": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind"
      ],
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "from": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "kind": {
          "enum": [
            "http",
            "dns",
            "read",
            "assume",
            "pass",
            "proxy",
            "redirect"
          ]
        },
        "deny": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(/[A-Za-z0-9._~-]+)*/?$"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "oidcProvider": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "approvedEgress": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": [
              "port",
              "method",
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "dns"
              }
            }
          },
          "then": {
            "required": [
              "port"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "read"
              }
            }
          },
          "then": {
            "required": [
              "action"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "assume"
              }
            }
          },
          "then": {
            "required": [
              "action",
              "oidcProvider",
              "audience",
              "subject"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pass"
              }
            }
          },
          "then": {
            "required": [
              "action"
            ]
          }
        }
      ]
    }
  }
}
