{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trustDomain",
    "spireParent",
    "workloads",
    "resources",
    "rules",
    "neverReach"
  ],
  "properties": {
    "trustDomain": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+\\.[a-z0-9.-]+$"
    },
    "spireParent": {
      "type": "string",
      "pattern": "^spiffe://[a-z0-9.-]+/spire/agent/.+$"
    },
    "workloads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workload"
      },
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "neverReach": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pair"
      }
    },
    "jwtAuthority": {
      "$ref": "#/$defs/jwtAuthority"
    },
    "httpRoutes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/httpRoute"
      }
    },
    "referenceGrants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/referenceGrant"
      }
    },
    "isolation": {
      "$ref": "#/$defs/isolation"
    },
    "federation": {
      "$ref": "#/$defs/federation"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AegisMesh intent",
  "$defs": {
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "namespace",
        "serviceAccount",
        "tenant",
        "svidTTL"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "serviceAccount": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "tenant": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "svidTTL": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "ingress": {
          "type": "boolean"
        },
        "untrusted": {
          "type": "boolean"
        },
        "svidClaims": {
          "$ref": "#/$defs/modelClaims"
        },
        "toolScope": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "trustDomain": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
        },
        "execAllowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~-]+)+$"
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "kind": {
          "enum": [
            "fqdn",
            "vault",
            "object",
            "role",
            "metadata",
            "internet",
            "cidr"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "from": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind"
      ],
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "from": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "kind": {
          "enum": [
            "http",
            "dns",
            "read",
            "assume",
            "pass",
            "proxy",
            "redirect"
          ]
        },
        "deny": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(/[A-Za-z0-9._~-]+)*/?$"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "oidcProvider": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "approvedEgress": {
          "type": "boolean"
        },
        "toolScope": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": [
              "port",
              "method",
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "dns"
              }
            }
          },
          "then": {
            "required": [
              "port"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "read"
              }
            }
          },
          "then": {
            "required": [
              "action"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "assume"
              }
            }
          },
          "then": {
            "required": [
              "action",
              "oidcProvider",
              "audience",
              "subject"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pass"
              }
            }
          },
          "then": {
            "required": [
              "action"
            ]
          }
        },
        {
          "if": {
            "required": [
              "toolScope"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "http"
              },
              "deny": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "modelClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "tool_scopes",
        "delegator_sub"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "tool_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "delegator_sub": {
          "type": "string",
          "pattern": "^spiffe://[a-z0-9.-]+/.+$"
        }
      }
    },
    "jwtAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "jwksURI"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^https://[^/?#]+(?:/[^?#]*)?$"
        },
        "jwksURI": {
          "type": "string",
          "pattern": "^https://[^/?#]+(?:/[^?#]*)?$"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "namespace",
        "gateway",
        "listener",
        "backend",
        "service",
        "hostname",
        "port",
        "method",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "gateway": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "listener": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "backend": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "service": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "hostname": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+\\.[a-z0-9.-]+$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(/[A-Za-z0-9._~-]+)*/?$"
        }
      }
    },
    "referenceGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "namespace",
        "fromNamespace",
        "service"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "fromNamespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "service": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        }
      }
    },
    "envoyAdmin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload",
        "address",
        "isolated"
      ],
      "properties": {
        "workload": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "isolated": {
          "type": "boolean"
        }
      }
    },
    "tlsSecretSync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceNamespace",
        "sourceName",
        "targetNamespace",
        "targetName"
      ],
      "properties": {
        "sourceNamespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "sourceName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "targetNamespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "targetName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        }
      }
    },
    "ipBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "cidr"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "cidr": {
          "type": "string",
          "minLength": 1
        },
        "except": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "envoyAdmins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envoyAdmin"
          }
        },
        "tlsSecretSyncs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tlsSecretSync"
          }
        },
        "clusterCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ipBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ipBlock"
          }
        }
      }
    },
    "federation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trustDomains",
        "allowReach"
      ],
      "properties": {
        "trustDomains": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/trustDomain"
          }
        },
        "allowReach": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pair"
          }
        }
      }
    },
    "trustDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster",
        "spireParent",
        "bundleEndpoint"
      ],
      "properties": {
        "cluster": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "spireParent": {
          "type": "string",
          "pattern": "^spiffe://[a-z0-9.-]+/spire/agent/[A-Za-z0-9._~/-]+$"
        },
        "bundleEndpoint": {
          "type": "string",
          "pattern": "^https://[^/?#]+(?:/[^?#]*)?$"
        },
        "trusts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
          }
        }
      }
    }
  }
}
